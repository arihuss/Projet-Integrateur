<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    tools:context=".vues.ProfilUserFragment">

    <!-- Image de profil -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvProfilUser"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:cardCornerRadius="50dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="75dp"
        android:layout_marginStart="30dp"
        app:cardBackgroundColor="@android:color/transparent">

        <ImageView
            android:id="@+id/imgUserProfil"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Photo de profil"
            tools:srcCompat="@tools:sample/avatars" />
    </androidx.cardview.widget.CardView>

    <!-- Prénom -->
    <TextView
        android:id="@+id/txtPrenomUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="John"
        android:textColor="@color/textsurbg"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@+id/cvProfilUser"
        app:layout_constraintStart_toEndOf="@+id/cvProfilUser"
        android:layout_marginStart="16dp" />

    <!-- Nom -->
    <TextView
        android:id="@+id/txtNomUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doe"
        android:textColor="@color/textsurbg"
        android:textSize="20sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/txtPrenomUser"
        app:layout_constraintStart_toStartOf="@+id/txtPrenomUser" />

    <!-- Bio -->
    <TextView
        android:id="@+id/txtBioUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="J'adore la plage et faire du bénévolat!"
        android:textColor="@color/textsurbg"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txtNomUser"
        app:layout_constraintStart_toStartOf="@+id/txtNomUser"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp" />

    <!-- Titre section -->
    <TextView
        android:id="@+id/txtExperienceBenevolat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Expérience de Bénévolat"
        android:textColor="@color/textsurbg"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/txtBioUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Liste des expériences (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExpUser"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/liste_des_exp_riences_de_b_n_volat"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/txtExperienceBenevolat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_experience_user" />


</androidx.constraintlayout.widget.ConstraintLayout>
